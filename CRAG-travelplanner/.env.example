# ==================== LLM配置 ====================
LLM_PROVIDER=qwen
LLM_FALLBACK_PROVIDER=gemini
# 主LLM - 通义千问 (Qwen)
# 获取方式：https://dashscope.aliyun.com/ -> API-KEY管理
QWEN_API_KEY=xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus-latest

# 备选LLM选项（按需配置）
# ----------------------------------------
# 获取方式：https://makersuite.google.com/app/apikey
GEMINI_API_KEY=xxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3-pro-preview
GOOGLE_PLACES_API_KEY=xxx
# OpenAI GPT（可选）
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# ==================== 数据库配置 ====================
# PostgreSQL源数据库
PG_HOST=localhost
PG_PORT=5434
PG_USER=postgres
PG_PASSWORD=secret
PG_DATABASE=TravelPlanner

# OceanBase连接（Docker本地部署）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=2881
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=crag_travelplanner

# 如使用OceanBase Cloud，请替换为：
# DATABASE_HOST=xxx.oceanbase.aliyuncs.com
# DATABASE_USER=root@tenant_name
# DATABASE_PASSWORD=your_cloud_password

# ==================== Embedding配置 ====================
# 向量嵌入模型 - 通义千问
# 获取方式：通常与QWEN_API_KEY相同
EMBEDDING_API_KEY=xxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ==================== Reranked配置 ====================
RERANK_MODEL_NAME=jina-reranker-v3
RERANK_API_KEY=xxx
# ==================== 应用配置 ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
SESSION_EXPIRE_HOURS=720

# ==================== Validator配置 ====================
# LLM 辅助验证：当正则无法识别用户回复时，使用 LLM 判断字段确认
# true = 启用（默认），false = 禁用（仅使用正则）
LLM_VALIDATION_ENABLED=true

# ==================== 可选：LangSmith追踪 ====================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=xxx
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=travelplanner-crag
